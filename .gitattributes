# Normalize line endings: LF in the repository, native on checkout where it
# matters. The build/tooling scripts require LF.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.sdoc text
*.cpp text
*.h text
*.qml text
*.md text
*.json text
*.yml text

# Generated files, committed for GitHub/Doxygen browsing — regenerated by
# their tools; mark so diffs de-emphasize them.
docs/requirements.md linguist-generated=true
ui-qt/qml/Theme.qml linguist-generated=true
shared/theme_tokens.h linguist-generated=true
